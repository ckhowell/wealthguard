# WealthGuard Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# TELEGRAM BOT (Required for alerts)
# ============================================
TELEGRAM_BOT_TOKEN=8333759366:AAGyK5X2W1Iq6jb0DVqgaxdZUriJG35fDG4
TELEGRAM_CHAT_ID=8504580841

# ============================================
# MARKET DATA APIs (At least one recommended)
# ============================================

# Jina AI - For scraping Yahoo Finance (Free tier: 200 requests/day)
# Get key at: https://jina.ai/api-dashboard
JINA_API_KEY=

# Alpha Vantage - Stock data (Free tier: 25 requests/day)
# Get key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub - Stock/Crypto/Forex (Free tier: 60 calls/minute)
# Get key at: https://finnhub.io/register
FINNHUB_API_KEY=

# CoinGecko - Crypto data (Free tier, no key needed for basic)
# Pro key optional for higher rate limits
COINGECKO_API_KEY=

# ============================================
# NEWS & SENTIMENT APIs (Optional)
# ============================================

# NewsAPI - Market news (Free tier: 100 requests/day)
# Get key at: https://newsapi.org/
NEWSAPI_KEY=

# ============================================
# DATABASE
# ============================================
DATABASE_PATH=/root/.openclaw/workspace/wealthguard.db

# ============================================
# OPTIONAL AUTH (LAN-only runs don't need this)
# ============================================
# If set, every /api/* request must carry `x-wg-password: <value>`
# (or `?wg_password=<value>`). The frontend's Settings > Auth page
# stores this in localStorage and injects it automatically.
# Leave blank to run unauthenticated.
WEALTHGUARD_PASSWORD=

# ============================================
# GEMINI (podcast audio transcription, advisor fallback)
# ============================================
# The ingest pipeline transcribes podcast audio with gemini-2.5-flash when
# no site transcript or YouTube caption is available. Also used as a fallback
# for the /api/advisor/narrative endpoint when Kimi is unavailable.
# GEMINI_API_KEY=...

# ============================================
# KIMI K2.6 (Moonshot AI — advisor narrative, podcast summaries, bulk categorisation)
# ============================================
# OpenAI-compatible chat API. K2.6 has 256K context and is ~cheap per token —
# used as the default provider for /api/advisor/narrative, PodBits summaries,
# and transaction-category inference in anz_llm_categorize.py.
# Docs: https://platform.kimi.ai/docs/guide/kimi-k2-6-quickstart
# KIMI_API_KEY=...
# KIMI_BASE_URL=https://api.moonshot.ai/v1     # default
# KIMI_MODEL=kimi-k2.6                         # default

# ============================================
# UPDATE FREQUENCY (seconds)
# ============================================
PRICE_UPDATE_INTERVAL=300
NEWS_UPDATE_INTERVAL=3600
FX_UPDATE_INTERVAL=3600

# ============================================
# SERVER CONFIG
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,https://given-ethics-part-gauge.trycloudflare.com

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
